# Database Configuration
DATABASE_HOST=localhost # Use 'postgres' inside Docker Compose, 'localhost' for local dev
DATABASE_PORT=5432
DATABASE_NAME=aramco_etl
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword

# Folder Paths
INPUT_FOLDER=./data/input
PROCESSING_FOLDER=./data/processing
PROCESSED_FOLDER=./data/processed
FAILED_FOLDER=./data/failed
ARCHIVE_FOLDER=./data/archive

# Cron & Batch Settings
CRON_SCHEDULE=*/15 * * * *
TIMEZONE=UTC
LOG_LEVEL=INFO
BATCH_SIZE=1000

# File & Retry Configuration
SUPPORTED_FILE_EXTENSIONS=.xlsx,.xls,.csv
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Alerting & Webhooks
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=http://localhost:8080/alerts

# Grafana Dashboard Access
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=adminpassword

